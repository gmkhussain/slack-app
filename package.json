{
  "name": "slack-app",
  "version": "1.0.0",
  "private": true,
  "description": "Slack ↔ Qiko monorepo: slack-to-qiko (inbound) + qiko-to-slack (outbound)",
  "scripts": {
    "slack-to-qiko": "npm run start --prefix slack-to-qiko",
    "slack-to-qiko:dev": "npm run dev --prefix slack-to-qiko",
    "slack-to-qiko:check": "npm run check --prefix slack-to-qiko",
    "qiko-to-slack": "npm run start --prefix qiko-to-slack",
    "qiko-to-slack:dev": "npm run dev --prefix qiko-to-slack",
    "qiko-to-slack:check": "npm run check --prefix qiko-to-slack"
  }
}
