# Copy to repo root .env or slack-to-qiko/.env

# Slack app (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_ADMIN_USER_TOKEN=xoxp-...  # workspace invite only (User Token Scopes: admin.users:write)
SLACK_SOCKET_MODE=false
# SLACK_APP_TOKEN=xapp-...   # only if SLACK_SOCKET_MODE=true

# Qiko worker
QIKO_API_BASE_URL=https://stage-backend.qiko.ai/api/avatar
QIKO_AGENT_UNIQUE_ID=your-worker-username
QIKO_DEFAULT_USER_EMAIL=slack-user@example.com

# SLACK_ALLOWED_CHANNEL_IDS=C01234567

PORT=3010
STRICT_PORT=true
