@baseUrl = http://localhost:3011

@channel = 'general'
# C0B4P79HLE9


@token = xoxb-

@thread_ts = 1779357592.930739

@slack_user = 'hussain.linkstar@gmail.com'

@slack_username = hussain

### ── CONFIG ──────────────────────────────────────────────

### Get current config (shows active bot_token hint & channel)
GET {{baseUrl}}/config


### Save bot_token + channel (persisted to runtime-config.json)
POST {{baseUrl}}/config
Content-Type: application/json

{
  "bot_token": "{{token}}",
  "channel": "{{channel}}"
}


### Update channel only (keep existing token)
POST {{baseUrl}}/config
Content-Type: application/json

{
  "channel": "{{channel}}"
}


### Update token only (keep existing channel)
POST {{baseUrl}}/config
Content-Type: application/json

{
  "bot_token": "{{token}}"
}


### ── DIRECT MESSAGE (DM) ────────────────────────────────

### DM by @username
POST {{baseUrl}}/dm
Content-Type: application/json

{
  "user": "@{{slack_username}}",
  "text": "Hello! This is a direct message from Qiko."
}


### DM by User ID
POST {{baseUrl}}/dm
Content-Type: application/json

{
  "user": "U0B4FAHG4F8",
  "text": "Hello! This is a direct message from Qiko."
}


### DM by email
POST {{baseUrl}}/dm
Content-Type: application/json

{
  "user": "{{slack_user}}",
  "text": "Hello! This is a direct message from Qiko."
}


### ── NOTIFY ───────────────────────────────────────────────

### Send a simple message (uses saved/env channel)
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "text": "Hello from {{channel}}!"
}


### Send to a specific channel
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "text": "Hello from Qiko!",
  "channel": "{{channel}}"
}


### Reply in a thread
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "text": "Reply in thread",
  "channel": "{{channel}}",
  "thread_ts": "{{thread_ts}}"
}


### Send with secret (if QIKO_SLACK_NOTIFY_SECRET is set)
POST {{baseUrl}}/notify
Content-Type: application/json
X-Notify-Secret: your-secret-here

{
  "text": "Authenticated message",
  "channel": "{{channel}}"
}


### ── JOIN ────────────────────────────────────────────────

### Add bot to a channel
POST {{baseUrl}}/join
Content-Type: application/json

{
  "channel": "{{channel}}"
}


### ── HEALTH ──────────────────────────────────────────────

### Health check
GET {{baseUrl}}/health
