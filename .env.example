# Slack app credentials (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# Workspace invite only (admin.users.invite) — User token xoxp-, NOT bot token. User Token Scopes: admin.users:write
# SLACK_ADMIN_USER_TOKEN=xoxp-your-user-oauth-token
# If Event URL verify fails with "challenge" error: copy Signing Secret again from Slack app settings.
# Debug only (then fix secret and remove): SLACK_SKIP_SIGNATURE_VERIFY=true
# HTTP mode (recommended when using ngrok + Event Subscriptions)
SLACK_SOCKET_MODE=false
# SLACK_APP_TOKEN=xapp-...   # only if SLACK_SOCKET_MODE=true

# Qiko worker (same agent_unique_id as /chat/:workerId in the web app)
QIKO_API_BASE_URL=https://stage-backend.qiko.ai/api/avatar
QIKO_AGENT_UNIQUE_ID=your-worker-username

# Fallback email when Slack user email is unavailable (API requires email)
QIKO_DEFAULT_USER_EMAIL=slack-user@example.com

# Optional: only respond in these Slack channel IDs (comma-separated). Empty = all channels.
# SLACK_ALLOWED_CHANNEL_IDS=C01234567,C07654321

# Server port when not using Socket Mode (SLACK_APP_TOKEN unset)
PORT=3010
STRICT_PORT=true
